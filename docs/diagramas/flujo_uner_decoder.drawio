<mxfile host="Electron">
  <diagram name="UnerProtocol – Decoder" id="uner-decoder">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ── Nodo inicio ───────────────────────────────── -->
        <mxCell id="n1" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;arcSize=50;strokeWidth=2;fillColor=#888780;strokeColor=#5F5E5A;fontColor=#fff;"
          value="feed(data): llega un byte al decodificador UNER">
          <mxGeometry x="195" y="50" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- ── Estados principales ──────────────────────── -->
        <mxCell id="n2" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;"
          value="WaitU: espera el primer byte del encabezado ('U')">
          <mxGeometry x="195" y="130" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n3" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;"
          value="WaitN: espera el segundo byte del encabezado ('N')">
          <mxGeometry x="195" y="240" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n4" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;"
          value="WaitE: espera el tercer byte del encabezado ('E')">
          <mxGeometry x="195" y="350" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n5" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;"
          value="WaitR: espera el cuarto byte del encabezado ('R')">
          <mxGeometry x="195" y="460" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n6" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;"
          value="ReadLen: guarda m_len y m_remaining = byte leído; limpia m_payload">
          <mxGeometry x="195" y="570" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n7" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;"
          value="WaitColon: espera el token separador ':' (0x3A)">
          <mxGeometry x="195" y="690" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n8" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#FAEEDA;strokeColor=#BA7517;fontColor=#633806;"
          value="ReadPayload: acumula bytes en m_payload y XOR acumulado en m_cks">
          <mxGeometry x="195" y="800" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ── Decisión remaining ────────────────────────── -->
        <mxCell id="n9" parent="1" vertex="1"
          style="rhombus;strokeWidth=2;whiteSpace=wrap;fillColor=#D3D1C7;strokeColor=#888780;fontColor=#2C2C2A;"
          value="¿remaining &gt; 1?">
          <mxGeometry x="205" y="920" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- ── Append payload (rama Sí) ──────────────────── -->
        <mxCell id="n10" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;"
          value="Byte de datos: se añade a m_payload, se acumula XOR y se decrementa m_remaining">
          <mxGeometry x="510" y="935" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ── Decisión checksum ──────────────────────────── -->
        <mxCell id="n11" parent="1" vertex="1"
          style="rhombus;strokeWidth=2;whiteSpace=wrap;fillColor=#D3D1C7;strokeColor=#888780;fontColor=#2C2C2A;"
          value="¿m_cks == byte_leído?">
          <mxGeometry x="205" y="1080" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- ── processPayload ────────────────────────────── -->
        <mxCell id="n12" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;"
          value="processPayload(): cmd = payload[0], datos = payload[1..n]; emite frameReceived(frame)">
          <mxGeometry x="195" y="1250" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ── Error checksum ────────────────────────────── -->
        <mxCell id="n13" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#712B13;"
          value="Error de checksum: emite checksumError(rawFrame)">
          <mxGeometry x="510" y="1100" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ── Reset ─────────────────────────────────────── -->
        <mxCell id="n14" parent="1" vertex="1"
          style="whiteSpace=wrap;strokeWidth=2;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#712B13;"
          value="reset(): m_state = WaitU, limpia rawFrame, payload y checksum">
          <mxGeometry x="510" y="130" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ══════════════ FLECHAS ══════════════ -->

        <!-- n1 → n2 -->
        <mxCell id="e1" edge="1" parent="1" source="n1" target="n2"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n2 → n3 (b=='U') -->
        <mxCell id="e2" edge="1" parent="1" source="n2" target="n3"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="b == 'U'">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n2 → reset (else) -->
        <mxCell id="e3" edge="1" parent="1" source="n2" target="n14"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="else">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n3 → n4 (b=='N') -->
        <mxCell id="e4" edge="1" parent="1" source="n3" target="n4"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="b == 'N'">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n3 → reset (else) -->
        <mxCell id="e5" edge="1" parent="1" source="n3" target="n14"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="else">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="270" />
              <mxPoint x="760" y="165" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- n4 → n5 (b=='E') -->
        <mxCell id="e6" edge="1" parent="1" source="n4" target="n5"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="b == 'E'">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n4 → reset (else) -->
        <mxCell id="e7" edge="1" parent="1" source="n4" target="n14"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="else">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="380" />
              <mxPoint x="760" y="165" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- n5 → n6 (b=='R') -->
        <mxCell id="e8" edge="1" parent="1" source="n5" target="n6"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="b == 'R'">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n5 → reset (else) -->
        <mxCell id="e9" edge="1" parent="1" source="n5" target="n14"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="else">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="490" />
              <mxPoint x="760" y="165" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- n6 → n7 -->
        <mxCell id="e10" edge="1" parent="1" source="n6" target="n7"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n7 → n8 (b==':') -->
        <mxCell id="e11" edge="1" parent="1" source="n7" target="n8"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="b == ':'">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n7 → reset (else) -->
        <mxCell id="e12" edge="1" parent="1" source="n7" target="n14"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="else">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="720" />
              <mxPoint x="760" y="165" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- n8 → n9 -->
        <mxCell id="e13" edge="1" parent="1" source="n8" target="n9"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n9 → n10 (Sí: remaining > 1) -->
        <mxCell id="e14" edge="1" parent="1" source="n9" target="n10"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="Sí">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n10 → n8 (loop: siguiente byte) -->
        <mxCell id="e15" edge="1" parent="1" source="n10" target="n8"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="siguiente byte">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="970" />
              <mxPoint x="790" y="835" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- n9 → n11 (No: último byte = checksum) -->
        <mxCell id="e16" edge="1" parent="1" source="n9" target="n11"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="No (último byte)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n11 → n12 (Sí: checksum OK) -->
        <mxCell id="e17" edge="1" parent="1" source="n11" target="n12"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="Sí">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n11 → n13 (No: error) -->
        <mxCell id="e18" edge="1" parent="1" source="n11" target="n13"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n12 → reset -->
        <mxCell id="e19" edge="1" parent="1" source="n12" target="n14"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="reset()">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="1285" />
              <mxPoint x="630" y="165" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- n13 → reset -->
        <mxCell id="e20" edge="1" parent="1" source="n13" target="n14"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;"
          value="reset()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- reset → WaitU (loop dashed) -->
        <mxCell id="e21" edge="1" parent="1" source="n14" target="n2"
          style="curved=1;startArrow=none;endArrow=block;rounded=0;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"
          value="espera nuevo byte">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="165" />
              <mxPoint x="480" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
