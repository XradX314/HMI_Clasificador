          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="675" />
              <mxPoint x="460" y="1260" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
